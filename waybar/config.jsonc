{
    // Onde a barra fica, na frente ou atrás de outras janelas
    "layer": "top",
    "position": "top",
    
    // Posições dos Módulos
    "modules-left": ["hyprland/workspaces", "group/hardware", "hyprland/window"],
    "modules-center":["custom/archicon"],
    "modules-right":["bluetooth", "backlight", "wireplumber", "battery", "network", "clock"],

    // Configurações dos Módulos
    "custom/archicon": {
        "format": " 󰣇 ",
        "tooltip": false,
        "on-click-right": "kitty -e btop"
    },
    
    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": false,
        "sort-by": "number",
        "active-only": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    
    "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "{:%H.%M}",
    "tooltip-format": "{:%d-%m-%Y}"
    },

    "hyprland/window": {
        "format": "{class}",
        "rewrite": {
            "brave-browser": "  Brave",
            "code": "  VSCode",
            "kitty": " 󰄛 Kitty",
            "steam": " 󰓓 Steam",
            "org.kde.dolphin": " 󱢴 Dolphin",
            "Godot": "  Godot",
            "jetbrains-studio": "  Android Studio",
            "org.vinegarhq.Sober": "  Sober",
            "org.prismlauncher.PrismLauncher": " 󰍳 Prism Launcher"
        },
        "separate-outputs": true,
        "tooltip": false
    },

        "wireplumber":{
            "format": "{icon} {volume}%",
            "format-icons": {
                "default": ["  ", "  "]
            },
            "format-muted": "  ",
            "on-click": "pavucontrol"
        },

        "backlight": {
            "device": "amdgpu_bl1",
            "format": "{icon} {percent}%",
            "format-icons": [" 󱩎 ", " 󱩏 ", " 󱩐 ", " 󱩑 ", " 󱩒 ", " 󱩓 ", " 󱩔 ", " 󱩕 ", " 󱩖 ", " 󰛨 "],
            "tooltip": false
        },
    // Configurações de Módulos de Informações do Sistema
    "custom/hardwareicon": {
        "format": "  ",
        "tooltip": false
    },

    "battery": {
        "format": "{icon}{capacity}%",
        "format-icons": {
            "default": [" 󰁺 ", " 󰁻 ", " 󰁼 ", " 󰁽 ", " 󰁾 ", " 󰁿 ", " 󰂀 ", " 󰂁 ", " 󰂂 "],
            "charging": [" 󰢜 ", " 󰂆 ", " 󰂇 ", " 󰂈 ", " 󰢝 ", " 󰂉 ", " 󰢞 ", " 󰂊 ", " 󰂋 "],
            "plugged": [" 󱧥 "],
            "full": [" 󰁹 "]
        },
        "full-at": 100,
        "interval": 60,
        "design-capacity": false,
        "tooltip": true,
        "tooltip-format": "Status: {timeTo}\nPower: {power}\nHealth: {health}",
        "states": {
            "attention": 50,
            "warning": 30,
            "critical": 15
        }
    },

    "bluetooth": {
        "format": " 󰂯 ",
        "format-off": " 󰂲 ",
        "format-connected": " 󰂰 ",
        "tooltip-format": "{status}",
        "tooltip-format-connected": "{status}\n{device_alias}",
        "on-click": "~/.config/waybar/scripts/bluetooth-toggle.sh",
        "on-click-right": "blueman-manager"
    },

    "cpu": {
        "interval": 60,
        "format": "  {usage}%"
    },

    "memory": {
        "interval": 60,
        "format": "  {percentage}%",
        "tooltip-format": "{used:0.1f}G/{total:0.1f}G"
    },

    "disk": {
        "interval": 60,
        "format": "  {percentage_free}%",
        "tooltip-format": "Livre: {free} | {percentage_free}%\nUsando: {used} | {percentage_used}%\nTotal: {total}"
    },

    "network": {
        "interval": 60,
        "format-wifi": "{icon} {essid}",
        "format-icons": [" 󰤟 ", " 󰤢 ", " 󰤥 ", " 󰤨 "],
        "format-ethernet": " 󰈀 ETH ",
        "format-disconnected": " 󰤮 Offline",
        "tooltip-format-wifi": "{essid}\n{signalStrength}\nIP: {ipaddr}\nGateway: {gwaddr}\nDonwload: {bandwidthDownBytes}\nUpload: {bandwidthUpBytes}\nTotal: {bandwidthTotalBytes}",
        "tooltip-format-ethernet": "IP: {ipaddr}\nGateway: {gwaddr}\nDonwload: {bandwidthDownBytes}\nUpload: {bandwidthUpBytes}\nTotal: {bandwidthTotalBytes}",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor"
    },

    "group/hardware": {
        "orientation": "horizontal",
        "drawer": {
            "transition-left-to-right": true
        },
        "modules": [
            "custom/hardwareicon",
            "cpu",
            "memory",
            "disk" 
        ]
    }
}